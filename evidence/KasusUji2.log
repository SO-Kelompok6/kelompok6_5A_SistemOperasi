#KU 2.1 (Uji Positif: Arsip, Timestamp, Permission 640)
SUMBER="$1"; TUJUAN="$2"; LOG_FILE="../evidence/backup.log"
mkdir -p ../evidence #Membuat folder evidence jika belum ada agar log bisa ditulis.
log() { ... } #Fungsi pencatat log berformat [timestamp] [LEVEL] pesan, ditambahkan (>>) ke backup.log tanpa menimpa isi sebelumnya.
mkdir -p "$TUJUAN" || { ... exit 4 } #Memastikan direktori tujuan ada. Jika gagal dibuat, skrip berhenti dengan exit status 4.
TS=$(date '+%Y-%m-%d_%H%M%S'); ARSIP="$TUJUAN/backup_${TS}.tar.gz"
  #Nama arsip memakai timestamp agar tidak menimpa arsip lama.
tar -czf "$ARSIP" -C "$(dirname "$SUMBER")" "$(basename "$SUMBER")"
  #Membuat arsip terkompresi gzip. Opsi -C membuat isi arsip memakai path relatif terhadap direktori induk sumber.
tar -tzf "$ARSIP" > /dev/null 2>&1 #Membaca ulang daftar isi arsip untuk memastikan hasilnya tidak korup. Jika gagal, arsip dihapus dan exit 5.
chmod 640 "$ARSIP" #Pemilik baca/tulis, grup hanya baca, lainnya tanpa akses.
echo "[SUCCESS] ..."; log SUCCESS ...; exit 0 #Mencatat ukuran arsip (stat -c %s) dan menandakan backup berhasil. Exit 0.

#KU 2.2 (Uji Positif: Kesesuaian Isi Ekstraksi)
  #Tidak ada baris kode khusus untuk uji ini. Arsip dari KU-2.1 diekstrak (tar -xzf) ke /tmp/cek lalu dibandingkan
  dengan sumber asli memakai diff -r. Karena tar memakai -C (path relatif), struktur direktori hasil ekstraksi sama dengan sumber.

#KU 2.3 (Uji Negatif: Direktori Tujuan Read-Only)
./validasi.sh "$SUMBER" "$TUJUAN"; RC=$?
if [ $RC -ne 0 ]; then ... exit $RC
  #Memanggil validasi.sh lalu menyimpan exit status-nya di RC. Jika bukan 0 (pada uji ini 3, tujuan read-only chmod 555),
  backup dibatalkan, tidak ada arsip dibuat, kegagalan dicatat ke log, dan exit status diteruskan apa adanya.

#KU 2.4 (Uji Negatif: Kegagalan Internal tar)
if ! tar -czf ... 2>>"$LOG_FILE"; then rm -f "$ARSIP"; ... exit 4
  #Validasi hanya mengecek direktori, sehingga berkas tanpa izin baca (chmod 000) lolos validasi dan baru gagal saat tar berjalan.
  Pesan error tar (stderr) dialihkan ke log, arsip parsial dihapus (rm -f), lalu exit 4.


#BUKTI KASUS UJI KU 2.1 HINGGA 2.4

